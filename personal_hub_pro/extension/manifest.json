{
  "manifest_version": 3,
  "name": "Personal Hub Pro",
  "version": "1.0.0",
  "description": "Access your Personal Hub Pro records securely.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Personal Hub Pro"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "https://YOUR-PRODUCTION-DOMAIN.example/*"
  ]
}